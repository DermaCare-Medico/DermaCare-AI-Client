# ---------------------------------------------------------------------------
# DermaCare AI — frontend environment
# Copy to `.env` and adjust for your local setup.
# ---------------------------------------------------------------------------

# Base URL of the DermaCare AI backend, INCLUDING the `/api/v1` prefix
# (OpenAPI server value: http://localhost:4000/api/v1). The frontend appends
# the endpoint paths directly, e.g. `${NEXT_PUBLIC_BASE_URL}/doctors`.
#
# IMPORTANT: Must NOT be the frontend origin (e.g. http://localhost:3000). If it
# is, requests such as /doctors are served by the Next.js app and return HTML
# instead of JSON.
NEXT_PUBLIC_BASE_URL="http://localhost:4000/api/v1"

# Optional demo fallbacks (default: disabled).
# When "true", a data view falls back to clearly-labelled demo records ONLY if
# the real request failed. Mutations NEVER fake success.
NEXT_PUBLIC_DOCTOR_DEMO="false"
NEXT_PUBLIC_PUBLIC_DEMO="false"
